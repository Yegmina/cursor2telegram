# Environment file consumed by systemd via EnvironmentFile=.
# Install at /etc/cursor2telegram/env (mode 0640, owner root:cursoragent).

# Required: bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional: Cursor API key for headless auth (alternative to `agent login`).
# CURSOR_API_KEY=

# Optional overrides.
# CURSOR_AGENT_BIN=/home/cursoragent/.local/bin/agent
# CURSOR_ENDPOINT=
# CURSOR2TELEGRAM_CONFIG=/etc/cursor2telegram/config.toml
# CURSOR2TELEGRAM_LOG_LEVEL=info
